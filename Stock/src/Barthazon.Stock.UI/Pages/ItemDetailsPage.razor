@page "/stock/articles/{Code}"
@inject IItemService Items
@inject IMovementService Movements
@inject ICurrentUser CurrentUser
@inject IDialogService Dialogs
@inject Notifier Notifier
@inject NavigationManager Navigation

@if (_notFound)
{
    <PageHeader Title="@StockTexts.ItemNotFound" BackHref="stock/articles" BackText="@StockTexts.ItemsTitle" />
    <EmptyState Title="@StockTexts.ItemNotFound" Icon="@Icons.Material.Outlined.SearchOff" />
}
else if (_item is null)
{
    <MudSkeleton Height="48px" Width="40%" />
    <MudSkeleton Height="200px" SkeletonType="SkeletonType.Rectangle" Class="mt-4" />
}
else
{
    <PageHeader Title="@($"{_item.Code} — {_item.Designation}")" BackHref="stock/articles" BackText="@StockTexts.ItemsTitle">
        <SubContent>
            <div class="d-flex flex-wrap gap-1 mt-1">
                <StatusChip Text="@_item.Kind.Label()" Tone="StatusTone.Neutral" />
                @if (_item.OwnerName is not null) { <StatusChip Text="@string.Format(CultureInfo.CurrentCulture, StockTexts.OwnedBy, _item.OwnerName)" Tone="StatusTone.Info" /> }
                @if (_item.IsArchived) { <StatusChip Text="@StockTexts.Archived" Tone="StatusTone.Disabled" /> }
                @if (_item.IsBelowThreshold) { <StatusChip Text="@StockTexts.BelowThreshold" Tone="@(_item.Quantity <= 0 ? StatusTone.Error : StatusTone.Warning)" /> }
            </div>
        </SubContent>
        <Actions>
            @if (CurrentUser.IsAuthenticated)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Input" OnClick="() => RecordAsync(StockAction.Receipt)" Disabled="_item.IsArchived">@StockTexts.ActionReceipt</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Output" OnClick="() => RecordAsync(StockAction.Issue)" Disabled="@(_item.Stock.Count == 0)">@StockTexts.ActionIssue</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="() => RecordAsync(StockAction.Transfer)" Disabled="@(_item.Stock.Count == 0)">@StockTexts.ActionTransfer</MudButton>
            }
            @if (CanEdit)
            {
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" aria-label="@StockTexts.MoreActions">
                    <ActivatorContent><MudIconButton Icon="@Icons.Material.Filled.MoreVert" Variant="Variant.Outlined" OnClick="@context.ToggleAsync" aria-label="@StockTexts.MoreActions" /></ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Icon="@Icons.Material.Filled.Tune" OnClick="() => RecordAsync(StockAction.Adjustment)">@StockTexts.ActionAdjustment</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Edit" Href="@($"stock/articles/{Uri.EscapeDataString(_item.Code)}/modifier")">@StockTexts.Edit</MudMenuItem>
                        <MudMenuItem Icon="@(_item.IsArchived ? Icons.Material.Filled.Unarchive : Icons.Material.Filled.Archive)" OnClick="ToggleArchiveAsync">
                            @(_item.IsArchived ? StockTexts.Restore : StockTexts.Archive)
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            }
        </Actions>
    </PageHeader>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="5">
            <section class="bz-card pa-4" aria-labelledby="bz-item-stock">
                <h2 id="bz-item-stock" class="bz-dashboard-title">@StockTexts.StockByLocation</h2>
                <MudText Typo="Typo.h4" Class="@(_item.IsBelowThreshold ? "bz-tone-warning" : null)">@StockLabels.Quantity(_item.Quantity, _item.Unit)</MudText>
                @if (_item.MinimumThreshold is { } threshold)
                {
                    <MudText Typo="Typo.body2" Class="bz-muted">@string.Format(CultureInfo.CurrentCulture, StockTexts.ThresholdValue, StockLabels.Quantity(threshold, _item.Unit))</MudText>
                }
                @if (_item.Value is { } value)
                {
                    <MudText Typo="Typo.body2" Class="bz-muted">@string.Format(CultureInfo.CurrentCulture, StockTexts.IndicativeValue, value.ToString("C2", CultureInfo.CurrentCulture))</MudText>
                }
                @if (_item.Stock.Count == 0)
                {
                    <MudText Class="bz-muted mt-3">@StockTexts.NothingInStock</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Elevation="0" Class="mt-3">
                        <thead><tr><th>@StockTexts.Location</th><th>@StockTexts.Lot</th><th style="text-align:right">@StockTexts.ColQuantity</th><th><span class="sr-only">@StockTexts.ColActions</span></th></tr></thead>
                        <tbody>
                            @foreach (var cell in _item.Stock)
                            {
                                <tr>
                                    <td><a href="@($"stock/emplacements/{Uri.EscapeDataString(cell.LocationCode)}")"><b>@cell.LocationCode</b></a> <span class="bz-muted">@cell.LocationName</span></td>
                                    <td>@cell.Lot</td>
                                    <td style="text-align:right;white-space:nowrap">@StockLabels.Quantity(cell.Quantity, cell.Unit)</td>
                                    <td style="width:1%"><CellActions OnAction="a => RecordAsync(a, cell.Key)" /></td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </section>
        </MudItem>
        <MudItem xs="12" md="7">
            <section class="bz-card pa-4" aria-labelledby="bz-item-info">
                <h2 id="bz-item-info" class="bz-dashboard-title">@StockTexts.Information</h2>
                <div class="bz-fields">
                    <FieldView Label="@StockTexts.Material" Value="@_item.MaterialName" />
                    <FieldView Label="@StockTexts.Shape" Value="@_item.Shape?.Label()" />
                    <FieldView Label="@StockTexts.Dimensions" Value="@_item.Dimensions" />
                    <FieldView Label="@StockTexts.Unit" Value="@_item.Unit.Label()" />
                    <FieldView Label="@StockTexts.Owner" Value="@(_item.OwnerName ?? StockTexts.OwnerCompanyName)" />
                    <FieldView Label="@StockTexts.DefaultLocation" Value="@_item.DefaultLocationCode" />
                    <FieldView Label="@StockTexts.UsualSupplier" Value="@_item.UsualSupplier" />
                    <FieldView Label="@StockTexts.ReferenceUnitCost" Value="@(_item.ReferenceUnitCost is { } cost ? $"{cost.ToString("C2", CultureInfo.CurrentCulture)} / {_item.Unit.Symbol()}" : null)" />
                    <FieldView Label="@StockTexts.TrackLots" Value="@(_item.TrackLots ? SharedTexts.Yes : SharedTexts.No)" />
                </div>
                @if (_item.Notes is not null)
                {
                    <FieldView Label="@StockTexts.Notes" Value="@_item.Notes" Class="mt-4" />
                }
                <MudText Typo="Typo.caption" Class="bz-muted mt-4 d-block">@string.Format(CultureInfo.CurrentCulture, StockTexts.UpdatedOnBy, _item.UpdatedAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture), _item.UpdatedBy)</MudText>
            </section>
        </MudItem>
        <MudItem xs="12">
            <section aria-labelledby="bz-item-movements">
                <div class="d-flex justify-space-between align-center mb-2">
                    <h2 id="bz-item-movements" class="bz-dashboard-title">@StockTexts.MovementsTitle</h2>
                    <MudButton Variant="Variant.Text" Href="@($"stock/mouvements?article={_item.Id}")" EndIcon="@Icons.Material.Filled.ArrowForward">@StockTexts.AllMovements</MudButton>
                </div>
                <MovementTable Items="_movements" Loading="@(_movements is null)" OnChanged="LoadAsync" />
            </section>
        </MudItem>
    </MudGrid>
}

@code {
    private ItemDetails? _item;
    private IReadOnlyList<MovementItem>? _movements;
    private bool _notFound;

    [Parameter] public string Code { get; set; } = string.Empty;

    private bool CanEdit => CurrentUser.Role >= UserRole.Editor;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Items.GetByCodeAsync(Code);
        _notFound = result.HasError(ErrorKind.NotFound);
        if (result.IsFailure)
        {
            Notifier.Handle(result);
            return;
        }

        _item = result.Value;
        var movements = await Movements.SearchAsync(new MovementSearchRequest { ItemId = _item.Id, PageSize = 20 });
        _movements = movements.IsSuccess ? movements.Value.Items : [];
    }

    private async Task RecordAsync(StockAction action, StockKey? cell = null)
    {
        if (await MovementDialog.ShowAsync(Dialogs, action, _item!.Id, cell?.LocationId, cell))
        {
            await LoadAsync();
        }
    }

    private async Task ToggleArchiveAsync()
    {
        if (Notifier.Handle(await Items.SetArchivedAsync(_item!.Id, !_item.IsArchived), StockTexts.Saved))
        {
            await LoadAsync();
        }
    }
}
