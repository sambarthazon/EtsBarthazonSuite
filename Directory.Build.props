<Project>
  <!-- Options communes à tous les projets de la solution. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <NeutralLanguage>fr</NeutralLanguage>
    <Company>Ets BARTHAZON</Company>
    <Product>Barthazon — Annuaire &amp; Stock</Product>
    <Version>2.0.0</Version>
    <!--
      Chaque projet est à la racine de son dossier (Portail/, Annuaire/…) : on ignore les dossiers bin/ et obj/
      imbriqués, par exemple ceux laissés par une compilation de la v1 (Portail/src/…/obj), qui provoqueraient
      l'erreur CS0579 (attributs d'assemblage en double).
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
