<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Application hôte (l'exécutable) : assemble le socle commun et les applications. Seul projet qui les connaît toutes. -->
  <PropertyGroup>
    <RootNamespace>Barthazon.Portail</RootNamespace>
    <AssemblyName>Barthazon.Portail</AssemblyName>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>
  <!--
    Retirer une application du portail : dotnet build Portail -p:SansStock=true (ou SansAnnuaire=true).
    L'autre application compile et fonctionne seule (blocs de coopération masqués).
  -->
  <PropertyGroup>
    <DefineConstants Condition="'$(SansStock)' == 'true'">$(DefineConstants);SANS_STOCK</DefineConstants>
    <DefineConstants Condition="'$(SansAnnuaire)' == 'true'">$(DefineConstants);SANS_ANNUAIRE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Commun\Barthazon.Commun.csproj" />
    <ProjectReference Include="..\Annuaire\Barthazon.Annuaire.csproj" Condition="'$(SansAnnuaire)' != 'true'" />
    <ProjectReference Include="..\Stock\Barthazon.Stock.csproj" Condition="'$(SansStock)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Barthazon.Tests" />
  </ItemGroup>
</Project>
