@using Barthazon.Shared.Infrastructure.Administration
@using System.Reflection
@using Barthazon.Shared.Kernel.Modules
@inject AdministrationService Administration
@inject IModuleCatalog Modules

@if (_status is null)
{
    <MudSkeleton Height="160px" SkeletonType="SkeletonType.Rectangle" />
}
else
{
    @if (_status.BackupOverdue)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3" Icon="@Icons.Material.Filled.Warning">@PortalTexts.StatusBackupOverdue</MudAlert>
    }
    @foreach (var warning in _status.Warnings)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-2">@warning</MudAlert>
    }
    <MudPaper Class="pa-4 bz-card" Elevation="0">
        <div class="bz-fields">
            <FieldView Label="@PortalTexts.StatusVersions">
                @foreach (var (name, version) in Versions())
                {
                    <div>@name : <b>@version</b></div>
                }
            </FieldView>
            <FieldView Label="@PortalTexts.StatusProvider" Value="@_status.DatabaseProvider" />
            <FieldView Label="@PortalTexts.StatusDatabasePath" Value="@_status.DatabasePath" />
            <FieldView Label="@PortalTexts.StatusFilesPath" Value="@_status.FilesPath" />
            <FieldView Label="@PortalTexts.StatusBackupPath" Value="@_status.BackupDirectory" />
            <FieldView Label="@PortalTexts.StatusAnonymousRead" Value="@(_status.AllowAnonymousRead ? PortalTexts.Yes : PortalTexts.No)" />
            <FieldView Label="@PortalTexts.StatusLastBackup"
                       Value="@(_status.Backup.LastSuccessAt?.ToLocalTime().ToString("g", CultureInfo.CurrentCulture) ?? PortalTexts.StatusNoBackup)" />
            <FieldView Label="@PortalTexts.StatusDisk">
                @foreach (var disk in _status.Disks)
                {
                    <div>
                        @(disk.FreeBytes is { } free
                            ? string.Format(CultureInfo.CurrentCulture, PortalTexts.StatusDiskValue, disk.Path, free / 1024d / 1024 / 1024, (disk.TotalBytes ?? 0) / 1024d / 1024 / 1024)
                            : string.Format(CultureInfo.CurrentCulture, PortalTexts.StatusDiskUnknownValue, disk.Path))
                    </div>
                }
            </FieldView>
        </div>
        @if (_status.Backup.LastError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@string.Format(CultureInfo.CurrentCulture, PortalTexts.StatusLastBackupError, _status.Backup.LastError)</MudAlert>
        }
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">@PortalTexts.StatusFilesReminder</MudAlert>
    </MudPaper>
}

@code {
    private SystemStatus? _status;

    protected override async Task OnInitializedAsync()
    {
        var result = await Administration.GetStatusAsync();
        _status = result.IsSuccess ? result.Value : null;
    }

    public async Task RefreshAsync()
    {
        await OnInitializedAsync();
        StateHasChanged();
    }

    /// <summary>Version de chaque brique : socle, portail, puis chaque application (6.1 de la spécification du stock).</summary>
    private IEnumerable<(string Name, string Version)> Versions()
    {
        yield return (PortalTexts.VersionSocle, VersionOf(typeof(IModule).Assembly));
        yield return (PortalTexts.VersionPortal, VersionOf(typeof(SystemStatusPanel).Assembly));
        foreach (var module in Modules.Modules.Where(m => m.IsApplication && m.UiAssembly is not null))
        {
            yield return (module.DisplayName, VersionOf(module.UiAssembly!));
        }
    }

    private static string VersionOf(Assembly assembly) =>
        assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion?.Split('+')[0] ?? "?";
}
