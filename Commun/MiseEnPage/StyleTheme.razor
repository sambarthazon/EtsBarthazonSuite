@inject ServiceTheme Theme
@* Apparence enregistrée (Paramètres → Apparence) injectée au chargement de chaque page, après theme.css. *@
<style>@((MarkupString)_css)</style>

@code {
    private string _css = string.Empty;

    protected override async Task OnInitializedAsync() => _css = ServiceTheme.Css(await Theme.Lire());
}
