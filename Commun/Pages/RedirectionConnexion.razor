@inject NavigationManager Navigation
@* Session absente ou expirée : on efface le cookie éventuel, puis écran de connexion (avec retour à la page demandée). *@

@code {
    protected override void OnInitialized()
    {
        var retour = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"{Authentification.CheminDeconnexion}?retour={Uri.EscapeDataString(retour)}", forceLoad: true);
    }
}
