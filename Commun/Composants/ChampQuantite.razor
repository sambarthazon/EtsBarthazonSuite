@* Saisie d'une quantité avec boutons − / + et clavier numérique sur mobile. *@
<div class="champ">
    @if (Etiquette is not null)
    {
        <label for="@_id">@Etiquette @if (Obligatoire) { <span class="champ__obligatoire">*</span> }</label>
    }
    <div class="champ-quantite">
        <button type="button" @onclick="Moins" aria-label="Diminuer">−</button>
        <input id="@_id" type="text" inputmode="decimal" autocomplete="off" class="saisie" value="@Texte" @onchange="Changer" />
        <button type="button" @onclick="Plus" aria-label="Augmenter">+</button>
        @if (Unite is not null)
        {
            <span class="champ-quantite__unite">@Unite</span>
        }
    </div>
    @if (Aide is not null)
    {
        <span class="champ__aide">@Aide</span>
    }
</div>

@code {
    private readonly string _id = "q" + Guid.NewGuid().ToString("N")[..8];

    [Parameter] public decimal? Valeur { get; set; }

    [Parameter] public EventCallback<decimal?> ValeurChanged { get; set; }

    [Parameter] public string? Etiquette { get; set; }

    [Parameter] public string? Unite { get; set; }

    [Parameter] public string? Aide { get; set; }

    [Parameter] public bool Obligatoire { get; set; }

    [Parameter] public decimal Pas { get; set; } = 1;

    [Parameter] public decimal Minimum { get; set; }

    private string Texte => Valeur is null ? string.Empty : Valeur.Value.ToString("0.###", Format.Culture);

    private async Task Changer(ChangeEventArgs e)
    {
        var texte = (e.Value?.ToString() ?? string.Empty).Replace('.', ',').Replace(" ", string.Empty, StringComparison.Ordinal);
        decimal? valeur = decimal.TryParse(texte, NumberStyles.Number, Format.Culture, out var v) ? v : null;
        await Definir(valeur);
    }

    private Task Moins() => Definir(Math.Max(Minimum, (Valeur ?? 0) - Pas));

    private Task Plus() => Definir((Valeur ?? 0) + Pas);

    private async Task Definir(decimal? valeur)
    {
        Valeur = valeur;
        await ValeurChanged.InvokeAsync(valeur);
    }
}
