@inject ILocationService Locations

@* Choix d'un emplacement (actifs ; l'emplacement déjà choisi reste affiché même s'il est archivé). *@
<MudSelect T="Guid?" Value="Value" ValueChanged="v => ValueChanged.InvokeAsync(v)" Label="@(Label ?? StockTexts.Location)" Variant="Variant.Outlined"
           Clearable="Clearable" Required="Required" RequiredError="@SharedTexts.RequiredField" Error="Error" ErrorText="@ErrorText" Margin="Margin"
           ToStringFunc="Display" AnchorOrigin="Origin.BottomCenter" Disabled="Disabled" HelperText="@HelperText">
    @foreach (var location in _locations.Where(l => !Exclude.Contains(l.Id)))
    {
        <MudSelectItem T="Guid?" Value="location.Id"><b>@location.Code</b> <span class="bz-muted">· @location.Name</span></MudSelectItem>
    }
</MudSelect>

@code {
    private IReadOnlyList<LocationItem> _locations = [];

    [Parameter] public Guid? Value { get; set; }

    [Parameter] public EventCallback<Guid?> ValueChanged { get; set; }

    [Parameter] public string? Label { get; set; }

    [Parameter] public string? HelperText { get; set; }

    [Parameter] public bool Required { get; set; }

    [Parameter] public bool Clearable { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool Error { get; set; }

    [Parameter] public string? ErrorText { get; set; }

    [Parameter] public Margin Margin { get; set; } = Margin.Normal;

    /// <summary>Emplacements à ne pas proposer (ex. l'origine d'un transfert).</summary>
    [Parameter] public IReadOnlyCollection<Guid> Exclude { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        var result = await Locations.ListAsync(includeArchived: true);
        if (result.IsSuccess)
        {
            _locations = result.Value.Where(l => !l.IsArchived || l.Id == Value).ToList();
        }
    }

    private string Display(Guid? id) =>
        _locations.FirstOrDefault(l => l.Id == id) is { } location ? $"{location.Code} — {location.Name}" : string.Empty;
}
