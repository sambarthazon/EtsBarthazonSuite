@* Spécifications d'un indice (lecture) : « Masse : 1,2 kg », « Longueur : 120 mm »… *@
@if (Specification.EstVide)
{
    <p class="doux">Aucune spécification.</p>
}
else
{
    <dl class="proprietes">
        @foreach (var ligne in Specification.Lignes)
        {
            <dt>@ligne.Libelle</dt><dd>@ligne.ValeurAffichee</dd>
        }
        @if (Specification.Remarques is not null) { <dt>Remarques</dt><dd style="white-space: pre-line">@Specification.Remarques</dd> }
    </dl>
}

@code {
    [Parameter, EditorRequired] public SpecificationAffichee Specification { get; set; } = default!;
}
