@* Gamme d'un indice (lecture, impression). *@
@if (Operations.Count == 0)
{
    <p class="doux">Aucune opération.</p>
}
else
{
    <table class="tableau gamme">
        <thead><tr><th>N°</th><th>Poste</th><th>Description</th><th class="droite">Temps</th><th>Remarque</th></tr></thead>
        <tbody>
            @foreach (var o in Operations)
            {
                <tr>
                    <td class="numero">@o.Numero</td>
                    <td>@o.Poste</td>
                    <td style="white-space: pre-line">@o.Description</td>
                    <td class="droite nombre">@(o.TempsEstimeMin is { } t ? $"{t} min" : null)</td>
                    <td>@o.Remarque</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<OperationAffichee> Operations { get; set; } = [];
}
