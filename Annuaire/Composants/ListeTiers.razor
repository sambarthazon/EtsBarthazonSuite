@inject ServiceReferentiels Referentiels
@inject IUtilisateurCourant Courant
@inject NavigationManager Navigation
<PageTitle>@Titre — Annuaire</PageTitle>

<EntetePage Titre="@Titre">
    <Actions>
        @if (Courant.Peut(Role.Gestion))
        {
            <GrosBouton Style="principal" Gros="true" Icone="plus" Texte="@($"Nouveau {Nature}")" OnClick="() => _fenetre = true" />
        }
    </Actions>
</EntetePage>

<ListeRecherchable T="LigneTiers" Elements="_liste" TexteRecherche="@(t => $"{t.Nom} {t.Contact} {t.Telephone} {t.Email}")" Lien="@(t => $"{Chemin}/{t.Id}")"
                   Placeholder="@($"Rechercher un {Nature}…")" Singulier="@Nature" Pluriel="@(Nature + "s")" MessageVide="@($"Aucun {Nature} pour l'instant")">
    <Filtres>
        <label class="case"><input type="checkbox" @bind="_archives" @bind:after="Charger" /> Afficher les archivés</label>
    </Filtres>
    <Entetes>
        <th>Nom</th><th>Contact</th><th>Téléphone</th><th class="droite">@Utilisations</th>
    </Entetes>
    <Ligne Context="t">
        <td><a class="lien-ligne" href="@Chemin/@t.Id">@t.Nom</a> @if (t.Archive) { <span class="etiquette">archivé</span> }</td>
        <td>@t.Contact</td>
        <td>@t.Telephone</td>
        <td class="droite nombre">@t.Utilisations</td>
    </Ligne>
    <Carte Context="t">
        <div class="carte__titre">@t.Nom @if (t.Archive) { <span class="etiquette">archivé</span> }</div>
        <div class="carte__ligne"><span>@t.Contact</span><span>@t.Telephone</span><span>@t.Utilisations @Utilisations.ToLowerInvariant()</span></div>
    </Carte>
</ListeRecherchable>

<FenetreTiers Ouverte="_fenetre" OuverteChanged="Fermer" Sorte="Sorte" OnEnregistre="Cree" />

@code {
    private IReadOnlyList<LigneTiers>? _liste;
    private bool _archives;
    private bool _fenetre;

    /// <summary>Clients ou fournisseurs : chaque sorte a sa propre page (Pages/Tiers), donc sa propre instance.</summary>
    [Parameter, EditorRequired] public SorteTiers Sorte { get; set; }

    private string Chemin => Sorte == SorteTiers.Client ? "/annuaire/clients" : "/annuaire/fournisseurs";

    private string Nature => Sorte == SorteTiers.Client ? "client" : "fournisseur";

    private string Titre => Sorte == SorteTiers.Client ? "Clients" : "Fournisseurs";

    private string Utilisations => Sorte == SorteTiers.Client ? "Pièces finies" : "Bruts fournis";

    /// <summary>Page d'origine où revenir après la création (ex. /annuaire/clients/nouveau?retour=…).</summary>
    [Parameter] public string? Retour { get; set; }

    /// <summary>Adresse …/nouveau : la fiche de création s'ouvre directement.</summary>
    [Parameter] public bool Creation { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _fenetre = Creation && Courant.Peut(Role.Gestion);
        await Charger();
    }

    private async Task Charger() => _liste = await Referentiels.ListerTiers(Sorte, _archives);

    private void Cree(int id) =>
        Navigation.NavigateTo(Authentification.RetourSur(Retour) is var r && r != "/" ? r : $"{Chemin}/{id}");

    private void Fermer(bool ouverte)
    {
        _fenetre = ouverte;
        if (!ouverte && Creation)
        {
            Navigation.NavigateTo(Authentification.RetourSur(Retour) is var r && r != "/" ? r : Chemin);
        }
    }
}
