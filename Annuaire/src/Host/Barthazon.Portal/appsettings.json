{
  "App": {
    "Name": "Barthazon — Outils atelier",
    "CompanyName": "Ets BARTHAZON",
    "LogoUrl": "img/logo.svg",
    "PublicBaseUrl": "http://pc-bureau:5080",
    "Culture": "fr-FR"
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=D:\\Barthazon\\data\\barthazon.db",
    "ApplyMigrationsOnStartup": true
  },
  "FileStorage": {
    "RootPath": "D:\\Barthazon\\files",
    "MaxFileSizeMb": 100
  },
  "Backup": {
    "Enabled": true,
    "Directory": "\\\\SERVEUR\\Sauvegardes\\Barthazon",
    "DailyAt": "12:30",
    "RetentionDays": 30
  },
  "Security": {
    "AllowAnonymousRead": true,
    "SessionDays": 30
  },
  "Features": {
    "Stock": false,
    "Deliveries": false,
    "Orders": false,
    "TimeTracking": false
  },
  "Catalog": {
    "ReferencePattern": "P-{0:0000}"
  },
  "Seed": {
    "DemoData": false
  },
  "Logging": {
    "Directory": "logs",
    "RetainedDays": 14
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  },
  "AllowedHosts": "*"
}
