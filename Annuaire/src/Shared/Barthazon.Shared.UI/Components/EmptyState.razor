@* État vide explicite, avec action éventuelle (ex. « effacer les filtres »). *@
<div class="bz-empty" role="status">
    <svg viewBox="0 0 24 24" aria-hidden="true">@((MarkupString)(Icon ?? Icons.Material.Outlined.Inbox))</svg>
    <MudText Typo="Typo.h6" Class="mt-2">@Title</MudText>
    @if (Text is not null)
    {
        <MudText Typo="Typo.body2">@Text</MudText>
    }
    @if (ChildContent is not null)
    {
        <div class="mt-4">@ChildContent</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Text { get; set; }

    [Parameter] public string? Icon { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
