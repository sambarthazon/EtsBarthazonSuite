@inject IClassificationService Classification
@inject Notifier Notifier

<MudDialog>
    <DialogContent>
        <FormErrors State="_form" />
        <MudTextField @bind-Value="_input.Name" Label="@CatalogTexts.FamilyName" Required="true" RequiredError="@SharedTexts.RequiredField" Variant="Variant.Outlined" AutoFocus="true"
                      Error="_form.HasError(nameof(FamilyInput.Name))" ErrorText="@_form.ErrorFor(nameof(FamilyInput.Name))" />
        <MudTextField @bind-Value="_input.Description" Label="@CatalogTexts.FamilyDescription" Variant="Variant.Outlined" Lines="2" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog!.Cancel()">@SharedTexts.Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">@SharedTexts.Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly FormState _form = new();
    private FamilyInput _input = new();

    [CascadingParameter] private IMudDialogInstance? Dialog { get; set; }

    [Parameter] public FamilyItem? Item { get; set; }

    protected override void OnInitialized()
    {
        if (Item is not null)
        {
            _input = new FamilyInput { Name = Item.Name, Description = Item.Description, Version = Item.Version };
        }
    }

    private async Task SaveAsync()
    {
        var result = await Classification.SaveFamilyAsync(Item?.Id, _input);
        _form.Apply(result);
        if (result.IsSuccess)
        {
            Notifier.Success(CatalogTexts.Saved);
            Dialog!.Close(DialogResult.Ok(result.Value));
        }
    }
}
