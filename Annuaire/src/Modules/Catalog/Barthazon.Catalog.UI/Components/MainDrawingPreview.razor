@* Aperçu du plan principal de l'indice affiché (vue d'ensemble). *@
@if (Document is null)
{
    <MudText Class="bz-muted">@CatalogTexts.NoMainDrawing</MudText>
}
else
{
    <MudText Typo="Typo.subtitle2" Class="mb-2">@Document.Title</MudText>
    <DocumentPreview Document="Document" MaxPages="1" />
}

@code {
    [Parameter] public DocumentDto? Document { get; set; }
}
