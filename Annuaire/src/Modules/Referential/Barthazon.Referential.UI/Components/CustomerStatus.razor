@if (IsArchived)
{
    <StatusChip Text="@ReferentialTexts.StatusArchived" Tone="StatusTone.Disabled" />
}
else if (IsActive)
{
    <StatusChip Text="@ReferentialTexts.StatusActive" Tone="StatusTone.Success" />
}
else
{
    <StatusChip Text="@ReferentialTexts.StatusInactive" Tone="StatusTone.Warning" />
}

@code {
    [Parameter] public bool IsActive { get; set; }

    [Parameter] public bool IsArchived { get; set; }
}
