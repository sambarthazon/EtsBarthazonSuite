@page "/annuaire/clients"
@page "/annuaire/clients/nouveau"
@inject NavigationManager Navigation
<ListeTiers Sorte="SorteTiers.Client" Creation="@Creation" Retour="@Retour" />

@code {
    [SupplyParameterFromQuery(Name = "retour")] private string? Retour { get; set; }

    private bool Creation => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].EndsWith("/nouveau", StringComparison.OrdinalIgnoreCase);
}
