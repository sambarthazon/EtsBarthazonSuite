@page "/referentiels"

<PageHeader Title="@ReferentialTexts.ReferentialsTitle" Subtitle="@ReferentialTexts.ReferentialsSubtitle" />

<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-4" KeepPanelsAlive="false" Border="false">
    <MudTabPanel Text="@ReferentialTexts.TabMaterials" Icon="@Icons.Material.Filled.Category">
        <MaterialsPanel />
    </MudTabPanel>
    <MudTabPanel Text="@ReferentialTexts.TabMachines" Icon="@Icons.Material.Filled.PrecisionManufacturing">
        <MachinesPanel />
    </MudTabPanel>
    @* Onglets fournis par les autres modules (familles et étiquettes de l'annuaire). *@
    <UiSlot Name="@UiSlots.ReferentialTabs">
        <ItemTemplate Context="slot">
            <MudTabPanel Text="@slot.Extension.Title" Icon="@slot.Extension.Icon">@slot.Content</MudTabPanel>
        </ItemTemplate>
    </UiSlot>
</MudTabs>
